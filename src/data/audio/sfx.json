  "rules": [
    {
      "event": "enemy_telegraph",
      "when": {
        "telegraphKind": "heavy"
      },
      "sound": "telegraphHeavy"
    },
    {
      "event": "enemy_telegraph",
      "when": {
        "telegraphKind": "aim"
      },
      "sound": "telegraphAim"
    },
    {
      "event": "health_changed",
      "when": {
        "actorIsPlayer": true,
        "lowHealthRising": true
      },
      "sound": "lowHealth"
    },
    {
      "event": "currency_changed",
      "when": {
        "positiveDelta": true
      },
      "sound": "pickup"
    },
    {
      "event": "implant_acquired",
      "sound": "pickup"
    },
    {
      "event": "meta_rewards",
      "sound": "runReward"
    },
    {
      "event": "explosion",
      "sound": "explosion"
    },
    {
      "event": "execute_performed",
      "sound": "hitHeavy"
    },
    {
      "event": "damage_dealt",
      "when": {
        "targetIsPlayer": true
      },
      "sound": "playerHurt"
    },
    {
      "event": "damage_dealt",
      "when": {
        "killed": true
      },
      "sound": "kill"
    },
    {
      "event": "damage_dealt",
      "when": {
        "tagsAny": ["#wall"]
      },
      "sound": "wallSlam"
    },
    {
      "event": "damage_dealt",
      "when": {
        "tagsAny": ["#heavy"]
      },
      "sound": "hitHeavy"
    },
    {
      "event": "damage_dealt",
      "when": {
        "tagsAny": ["#melee", "#power"]
      },
      "sound": "hitLight"
    },
    {
      "event": "damage_dealt",
      "when": {
        "tagsAny": ["#gun"]
      },
      "sound": "hitGun"
    },
    {
      "event": "melee_swing",
      "when": {
        "actorIsPlayer": true
      },
      "sound": "swing"
    },
    {
      "event": "melee_blocked",
      "sound": "block"
    },
    {
      "event": "parry_success",
      "sound": "parry"
    },
    {
      "event": "melee_parried",
      "sound": "parry"
    },
    {
