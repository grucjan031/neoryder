  "rules": [
    { "event": "execute_performed", "sound": "hitHeavy" },
    { "event": "damage_dealt", "when": { "targetIsPlayer": true }, "sound": "playerHurt" },
    { "event": "damage_dealt", "when": { "killed": true }, "sound": "kill" },
    { "event": "damage_dealt", "when": { "tagsAny": ["#wall"] }, "sound": "wallSlam" },
    { "event": "damage_dealt", "when": { "tagsAny": ["#heavy"] }, "sound": "hitHeavy" },
    { "event": "damage_dealt", "when": { "tagsAny": ["#melee", "#power"] }, "sound": "hitLight" },
    { "event": "damage_dealt", "when": { "tagsAny": ["#gun"] }, "sound": "hitGun" },
    { "event": "melee_swing", "when": { "actorIsPlayer": true }, "sound": "swing" },
    { "event": "melee_blocked", "sound": "block" },
    { "event": "parry_success", "sound": "parry" },
    { "event": "weapon_fired", "when": { "actorIsPlayer": true }, "sound": "blasterShot" },
    { "event": "projectile_spawned", "when": { "team": "enemy" }, "sound": "enemyShot" },
    { "event": "heat_changed", "when": { "overheatRising": true }, "sound": "overheat" },
    { "event": "power_used", "when": { "actorIsPlayer": true }, "sound": "push" },
    { "event": "power_denied", "when": { "actorIsPlayer": true }, "sound": "denied" },
    { "event": "player_landed", "when": { "minSpeed": 7 }, "sound": "land" },
    { "event": "dash_used", "when": { "actorIsPlayer": true }, "sound": "dash" },
    { "event": "enemy_telegraph", "sound": "telegraph" },
    { "event": "wave_started", "sound": "waveStart" },
    { "event": "wave_cleared", "sound": "waveCleared" }
  ]
