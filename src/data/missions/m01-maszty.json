  "briefing": [
    {
      "speaker": "szron",
      "text": "Trzy maszty w Niecce. Stanęły dziś w nocy, wszystkie na tym samym paśmie, które złapało cię na rampie."
    },
    {
      "speaker": "mira",
      "text": "Trzy sztuki, z krótkim zapalnikiem. Przykładaj do skrzynki zasilania u podstawy, nie do samej kratownicy."
    }
  ],
  "debrief": [
    {
      "speaker": "bajt",
      "text": "Dobra, mam to. Zerwałem obudowę Kurogane, a w środku siedzi pełna elektronika Helixa Dynamics."
    },
    {
      "speaker": "szron",
      "text": "Do łączności?"
    }
  ],
  "radio": [
    {
      "trigger": "runStart",
      "lines": [
        {
          "speaker": "tomasz",
          "text": "Słychać mnie dobrze? Jesteś pod trzecią podporą, za plecami masz zejście do kanału."
        }
      ]
    },
    {
      "trigger": "objective:mast-1:done",
      "lines": [
        {
          "speaker": "bajt",
          "text": "Pierwszy ucichł. Reszta sieci podbiła moc o trzydzieści procent — wiedzą już, że to nie awaria bezpieczników."
        }
      ]
    },
    {
      "trigger": "objective:mast-2:done",
      "lines": [
        {
          "speaker": "mira",
          "text": "Czekaj — coś w tym pieprzonym złomie jeszcze nie zgasło. Pod pokrywą leży nienaruszony moduł. Zgarnij go, przyda się w warsztacie."
        }
      ]
    },
    {
      "trigger": "objective:helix:done",
      "lines": [
        {
          "speaker": "bajt",
          "text": "Chwila... zanim schowasz, wyłapałem jego identyfikator serwisowy. To nie jest blok Kurogane. To ma sygnaturę Helixa Dynamics."
        }
      ]
    },
    {
      "trigger": "objective:mast-3:done",
      "lines": [
        {
          "speaker": "bajt",
          "text": "Trzeci padł, kurwa mać! Pasma w Niecce są puste, przed świtem niczego już nie zestroją."
        }
      ]
    },
    {
      "trigger": "objective:exit:started",
      "lines": [
        {
          "speaker": "mira",
          "text": "Otwieraj i schodź. Jak przekręcisz zawór od środka, nie przejdą bez palników."
        }
      ]
    }
  ],
  "rewards": {
    "firstClear": {
      "data": 60
    }
  },
  "summary": "Tej nocy po incydencie na rampie Kurogane Arms stawia w Niecce trzy prowizoryczne maszty nasłuchowe, żeby przed świtem zamknąć triangulację na Kurierze. Kurier wchodzi w uliczki pod estakadami, wysadza przekaźniki ładunkami od Miry i odpiera ściągane wybuchami patrole."
