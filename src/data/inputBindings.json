{
  "keyboard": {
    "KeyW": "moveForward",
    "KeyS": "moveBack",
    "KeyA": "moveLeft",
    "KeyD": "moveRight",
    "Space": "jump",
    "ShiftLeft": "sprint",
    "ShiftRight": "sprint",
    "KeyQ": "dash",
    "ControlLeft": "crouch",
    "ControlRight": "crouch",
    "KeyR": "swap",
    "KeyV": "inspect",
    "KeyG": "coolWeapon",
    "KeyF": "power",
    "KeyE": "power2",
    "Digit1": "weapon1",
    "Digit2": "weapon2",
    "Digit3": "weapon3",
    "KeyM": "map",
    "Tab": "inventory",
    "KeyT": "squadCommand"
  },
  "mouse": { "0": "attack", "1": "bladeThrow", "2": "block" },
  "gamepad": {
    "0": { "press": "jump" },
    "1": { "press": "crouch" },
    "2": { "press": "dash" },
    "3": { "press": "swap", "hold": "inspect" },
    "4": { "press": "power2" },
    "5": { "press": "power" },
    "6": { "press": "block" },
    "7": { "press": "attack" },
    "8": { "press": "inventory", "hold": "map" },
    "9": { "press": "pause" },
    "10": { "press": "sprint" },
    "11": { "press": "bladeThrow" },
    "12": { "press": "weapon2" },
    "13": { "press": "coolWeapon", "hold": "squadCommand" },
    "14": { "press": "weapon1" },
    "15": { "press": "weapon3" }
  }
}
